# QRMenu SaaS - Backend Environment Configuration Template
# Copy this file to .env for local development:
# cp .env.example .env

# PostgreSQL Connection String (Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/qrmenu_db?schema=public"

# Backend Server Port
PORT=4000

# JWT Authentication Secret Key (generate a strong random string)
JWT_SECRET="your_strong_jwt_secret_key_here"

# Frontend Application URL (used for CORS and QR code link generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary Integration (Image asset hosting for restaurant logos and dishes)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Optional: Google Gemini API (for AI-powered menu extraction & item parsing)
GEMINI_API_KEY="your_gemini_api_key_optional"
